sep = "  " # Exact 2 spaces uniform kerning (matching official Omarchy logo)
lines = [""] * 8

for ch in text:
    glyph = GLYPHS.get(ch, GLYPHS[" "])
    for r in range(8):
        lines[r] += (sep if lines[r] else "") + glyph[r]

with open(out_file, "w", encoding="utf-8") as f:
    for line in lines:
        f.write(line.rstrip() + "\n")

print(f"✓ Generated Omarchy signature screensaver text for '{text}' ({len(text)} letters, exact 2-space Omarchy kerning)")
print(f"✓ Saved to {out_file}")
PYEOF
}

cmd_reset() {
  if [ -f "$DEFAULT_LOGO" ]; then
    mkdir -p "$BRANDING_DIR"
    cp "$DEFAULT_LOGO" "$BRANDING_FILE"
    echo "✓ Restored official Omarchy logo to screensaver"
  else
    rm -f "$BRANDING_FILE"
    echo "✓ Removed custom branding; screensaver will use system default"
  fi

  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send -g 󱄄 "Screensaver Reset" "Restored official Omarchy logo screensaver" 2>/dev/null || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -i screensaver -a "Omasaver" "Screensaver Reset" "Restored official Omarchy logo screensaver" 2>/dev/null || true
  fi
}

cmd_test() {
  local effect="${1:-decrypt}"
  local target_file="$BRANDING_FILE"
  if [ ! -f "$target_file" ]; then
    target_file="$DEFAULT_LOGO"
  fi

  local effect_flag="$effect"
  if [ "$effect" = "random" ]; then
    effect_flag="--random-effect"
  fi

  local max_line_len
  max_line_len=$(awk '{ if (length > max) max = length } END { print (max ? max : 80) }' "$target_file")
  local win_width=$(( max_line_len + 16 ))
  if (( win_width < 100 )); then
    win_width=100
  fi

  echo "Testing screensaver effect: '$effect' (matching default Omarchy font size 18 & 120 FPS)..."

  local runner="/tmp/omasaver-test-run.sh"
  cat > "$runner" << 'RUNNER_EOF'
#!/bin/bash
TARGET="$1"
EFFECT="$2"
printf '\033]11;rgb:00/00/00\007'
printf '\033[?25l'
stty -echo 2>/dev/null
cleanup() {
  printf '\033[?25h'
  stty echo 2>/dev/null
  exit 0
}
trap cleanup SIGINT SIGTERM EXIT

while true; do
  if [ "$EFFECT" = "--random-effect" ]; then
    ttfx -i "$TARGET" --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c --random-effect --no-eol --no-restore-cursor &
  else
    ttfx -i "$TARGET" --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c "$EFFECT" --no-eol --no-restore-cursor &
  fi
  PID=$!
  while kill -0 $PID 2>/dev/null; do
    if read -n1 -t 0.2; then
      kill $PID 2>/dev/null
      cleanup
    fi
  done
done
RUNNER_EOF
  chmod +x "$runner"

  local foot_cfg=""
  if [ -f "/usr/share/omarchy/default/foot/screensaver.ini" ]; then
    foot_cfg="--config=/usr/share/omarchy/default/foot/screensaver.ini"
  fi

  if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    hyprctl dispatch "hl.dsp.exec_cmd([[foot --app-id=TUI.float $foot_cfg -W ${win_width}x26 $runner $target_file $effect_flag]])" >/dev/null 2>&1 || \
      "$runner" "$target_file" "$effect_flag"
  else
    "$runner" "$target_file" "$effect_flag"
  fi
}

cmd_run() {
  if command -v omarchy-launch-screensaver >/dev/null 2>&1; then
    omarchy-launch-screensaver force
  else
    omarchy launch screensaver
  fi
}

cmd_list() {
  echo "Available Screensaver Effects in ttfx:"
  echo "======================================"
  for entry in "${EFFECTS[@]}"; do
    IFS=":" read -r name desc <<< "$entry"
    printf "  %-18s %s\n" "$name" "$desc"
  done
}

cmd_status() {
  if [ -f "$BRANDING_FILE" ]; then
    if cmp -s "$BRANDING_FILE" "$DEFAULT_LOGO"; then
      echo "Active screensaver: Default Omarchy logo ($DEFAULT_LOGO)"
      return
    fi
    echo "Active screensaver: Custom branding"
    echo "File: $BRANDING_FILE"
    echo "--- Preview ---"
    head -n 8 "$BRANDING_FILE"
  else
    echo "Active screensaver: Default Omarchy logo ($DEFAULT_LOGO)"
  fi
}

# Subcommand dispatch
case "${1:-help}" in
  set)
    shift
    cmd_set "$@"
    ;;
  reset)
    cmd_reset
    ;;
  test)
    shift
    cmd_test "$@"
    ;;
  run)
    cmd_run
    ;;
  list)
    cmd_list
    ;;
  status)
    cmd_status
    ;;
  help|--help|-h)
    show_help
    ;;
  *)
    echo "Unknown command: $1" >&2
    show_help >&2
    exit 1
    ;;
esac
