#!/usr/bin/env bash
set -euo pipefail

BRANDING_DIR="${HOME}/.config/omarchy/branding"
BRANDING_FILE="${BRANDING_DIR}/screensaver.txt"
DEFAULT_LOGO="/usr/share/omarchy/logo.txt"

EFFECTS=(
  "matrix:Matrix digital rain code"
  "decrypt:Movie-style decryption scramble"
  "fireworks:Exploding colorful fireworks"
  "rain:Falling rain drops settling into place"
  "beams:Sweeping searchlight beams"
  "bubbles:Floating soap bubbles that pop"
  "burn:Vertical flame wall burning down"
  "laseretch:High-precision laser engraving"
  "scattered:Flying scattered characters"
  "crumble:Crumbling dust and reformation"
  "blackhole:Singularity collapse and outward burst"
  "bouncyballs:Bouncing rubber balls"
  "colorshift:Chromatic RGB gradient shift"
  "slice:Horizontal sliding slices"
  "rings:Orbital spinning rings"
  "overflow:Buffer overflow rolling glitch"
  "orbittingvolley:Orbiting corner turret volleys"
  "pour:Liquid characters pouring from above"
  "binarypath:Streaming binary 0s and 1s"
  "errorcorrect:Glitch repair in sequence"
  "expand:Explosion outward from center"
  "middleout:Expansion from center row and column"
  "print:Mechanical vintage typewriter"
  "highlight:Specular light gleam"
)

show_help() {
  cat << 'HELP'
Omasaver - Custom Screensaver Branding & Effect Switcher for Omarchy

Usage:
  omasaver set "<text>" [options]  Generate and set screensaver in official Omarchy font
  omasaver reset                   Revert to official Omarchy logo
  omasaver test [effect]           Preview effect in floating terminal (default: decrypt)
  omasaver run                     Launch full-screen screensaver immediately
  omasaver list                    List all 24 available animation effects
  omasaver status                  Show current screensaver branding status
  omasaver dynamic <mode>          Activate a live dynamic screensaver mode
  omasaver dynamic stop            Stop any running dynamic daemon
  omasaver dynamic status          Show dynamic mode status
  omasaver help                    Show this help message

Options for 'set':
  --font, -f <large|compact>       Font size: 'large' (8-row, 1-7 chars) or 'compact' (5-row, 1-14 chars)
  --subtitle, -s "<text>"          Optional centered subtitle / tagline below main logo

Dynamic Modes:
  omasaver dynamic clock           Live clock (updates every minute, e.g. 14:30)
  omasaver dynamic user            Display current system username
  omasaver dynamic host            Display current system hostname

Examples:
  omasaver set "NIHAL"
  omasaver set "NIHAL" --subtitle "SOFTWARE ENGINEER"
  omasaver set "SHAIK NIHAL" --font compact
  omasaver set "DEVELOPER" --font compact --subtitle "ARCH LINUX"
  omasaver test decrypt
  omasaver test fireworks
  omasaver dynamic clock
  omasaver dynamic stop
  omasaver reset
HELP
}

cmd_set() {
  _stop_dynamic_daemon
  local text=""
  local subtitle=""
  local font="large"

  while (( $# > 0 )); do
    case "$1" in
      --font|-f)
        font="${2:-large}"
        shift 2
        ;;
      --subtitle|-s)
        subtitle="${2:-}"
        shift 2
        ;;
      *)
        if [ -z "$text" ]; then
          text="$1"
        elif [ -z "$subtitle" ]; then
          subtitle="$1"
        fi
        shift
        ;;
    esac
  done

  if [ -z "$text" ]; then
    echo "Error: Please provide text to set, e.g.: omasaver set \"NIHAL\"" >&2
    exit 1
  fi

  local clean
  clean=$(echo "$text" | tr '[:lower:]' '[:upper:]' | xargs)

  local max_chars=7
  if [ "$font" = "compact" ]; then
    max_chars=14
  fi

  if [ ${#clean} -gt $max_chars ]; then
    echo "⚠ Notice: Limiting screensaver text to $max_chars characters for '$font' font."
    echo "  Original: '$clean' (${#clean} chars) -> Using: '${clean:0:$max_chars}'"
    clean="${clean:0:$max_chars}"
  fi

  mkdir -p "$BRANDING_DIR"

  python3 - "$clean" "$BRANDING_FILE" "$font" "$subtitle" << 'PYEOF'
import sys

text = sys.argv[1].upper()
out_file = sys.argv[2]
font_style = sys.argv[3] if len(sys.argv) > 3 else "large"
subtitle = sys.argv[4] if len(sys.argv) > 4 else ""

