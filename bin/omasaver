is_compact = (font_style == "compact")
glyph_dict = GLYPHS_5 if is_compact else GLYPHS
row_count = 5 if is_compact else 8
sep = " " if is_compact else "  "
max_len = 14 if is_compact else 7
clean_text = text[:max_len]

lines = [""] * row_count

for ch in clean_text:
    glyph = glyph_dict.get(ch, glyph_dict[" "])
    for r in range(row_count):
        lines[r] += (sep if lines[r] else "") + glyph[r]

if subtitle and subtitle.strip():
    sub_clean = subtitle.strip().upper()[:36]
    logo_width = max(len(l) for l in lines if l)
    lines.append("")
    if len(sub_clean) < logo_width:
        pad = (logo_width - len(sub_clean)) // 2
        lines.append(" " * pad + sub_clean)
    else:
        lines.append(sub_clean)

with open(out_file, "w", encoding="utf-8") as f:
    for line in lines:
        f.write(line.rstrip() + "\n")

font_desc = "Compact 5-row" if is_compact else "Official 8-row"
sub_desc = f" with subtitle '{subtitle.strip()}'" if subtitle.strip() else ""
print(f"✓ Generated screensaver text for '{clean_text}' ({len(clean_text)} letters, {font_desc}{sub_desc})")
print(f"✓ Saved to {out_file}")
PYEOF
}

DYNAMIC_PID_FILE="/tmp/omasaver-dynamic.pid"
DYNAMIC_MODE_FILE="/tmp/omasaver-dynamic.mode"

_stop_dynamic_daemon() {
  if [ -f "$DYNAMIC_PID_FILE" ]; then
    local pid
    pid=$(cat "$DYNAMIC_PID_FILE" 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
    fi
    rm -f "$DYNAMIC_PID_FILE" "$DYNAMIC_MODE_FILE"
  fi
}

# Generate screensaver text using embedded Python glyph engine
_generate_text() {
  local text="$1"
  python3 - "$text" "$BRANDING_FILE" << 'DYNPYEOF'
import sys

text = sys.argv[1].upper()[:7]
out_file = sys.argv[2]

GLYPHS = {
  "0": [" ▄█████▄ ","███   ███","███   ███","███   ███","███   ███","███   ███","███   ███"," ▀█████▀ "],
  "1": ["   ████  "," ▄█████  ","   ████  ","   ████  ","   ████  ","   ████  "," ▄██████▄","▀▀▀▀▀▀▀▀▀"],
  "2": [" ▄██████▄","███▀  ▀██","      ███","   ▄▄███▀"," ▄████▀▀ ","███▀     ","█████████","▀▀▀▀▀▀▀▀▀"],
  "3": [" ▄██████▄","███▀  ▀██","      ███","  ▄▄████▀"," ▀▀████▄ ","      ███","███▄  ▄██"," ▀██████▀"],
  "4": ["   ▄████ ","  ██████ "," ███ ███ ","▄██  ███ ","█████████","▀▀▀  ███ ","     ███ ","    ▄███▄"],
  "5": ["█████████","███▀▀▀▀▀▀","████████▄","▀▀▀▀▀▀▀██","      ███","███   ███","███▄ ▄███"," ▀██████▀"],
  "6": [" ▄██████▄","███▀   ▀▀","███      ","████████▄","███▀  ███","███   ███","███▄ ▄███"," ▀██████▀"],
  "7": ["█████████","▀▀▀▀▀▀███","     ████","    ████ ","   ████  ","  ████   ","  ████   ","  ▀███▀  "],
