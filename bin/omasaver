  clean=$(echo "$text" | tr '[:lower:]' '[:upper:]' | xargs)

  if [ ${#clean} -gt 7 ]; then
    echo "⚠ Notice: Limiting screensaver text to 7 characters for perfect terminal & screensaver boundaries."
    echo "  Original: '$clean' (${#clean} chars) -> Using: '${clean:0:7}'"
    clean="${clean:0:7}"
  fi

  mkdir -p "$BRANDING_DIR"

